Options -Indexes -MultiViews
# No script execution anywhere under uploads (SECURITY.md 12.2)
<FilesMatch "\.(php|phtml|phar|cgi|pl|py|sh)$">
    Require all denied
</FilesMatch>
<IfModule mod_php.c>
    # php_flag only: php_admin_* directives are invalid inside .htaccess and 500 every image.
    php_flag engine off
</IfModule>
